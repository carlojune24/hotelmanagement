# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://mmhotel:mmhotel@localhost:5432/mmhotel

# Public origin of the app, used for building absolute URLs (PayMongo redirects, emails).
ORIGIN=http://localhost:5175

# Origin the server uses to reach its OWN print routes when rendering a PDF
# (headless Chromium via Playwright — `pnpm exec playwright install chromium`).
# Set it to the local/internal address whenever ORIGIN is a tunnel or public edge.
# Falls back to ORIGIN when blank.
PDF_RENDER_ORIGIN=http://localhost:5175

# Encrypts per-hotel secrets at rest (PayMongo keys, SMTP passwords) — 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: changing it makes every saved secret undecryptable (reconnect each hotel).
APP_ENCRYPTION_KEY=

# PayMongo is per hotel: each hotel admin connects their own account under
# Settings → Payments & email (the webhook is registered automatically at
# /api/webhooks/paymongo/{hotel}). A hotel with no connection can't take online payment.
# LEGACY, switch-over only: the old platform-wide webhook (/api/webhooks/paymongo) keeps
# working while this is set, so payments already in flight still confirm. Remove it once
# every hotel is connected.
# PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# Minutes an unpaid order may hold its rooms before the hold is released
# (default 60, matches PayMongo's hosted-checkout-session lifetime; min 5).
PENDING_ORDER_TTL_MINUTES=60

# Platform SMTP — the fallback for hotels that haven't set their own mailbox under
# Settings → Payments & email (sent under the hotel's name). Leave SMTP_HOST blank and
# the app prints each email to the server console instead of sending. For a real
# render locally: `npx maildev` then SMTP_HOST=localhost SMTP_PORT=1025.
# In prod point these at SES / Mailgun / Gmail / Resend's SMTP bridge.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MM Hotel <no-reply@example.com>"

# Argon2 secret pepper (optional; 32+ random bytes, base64)
AUTH_PEPPER=

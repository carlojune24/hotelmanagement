# City instance (branch `city`). Copy to .env.city. Loaded by `pnpm city:dev` (vite --mode city)
# ON TOP of .env, so anything set here wins. AUTH_PEPPER / APP_ENCRYPTION_KEY are inherited from
# .env on purpose: the cloned DB's password hashes and encrypted settings only work with the same keys.
DATABASE_URL=postgres://hotels_city:hotels_city@localhost:5432/hotels_city
ORIGIN=http://localhost:5174
PDF_RENDER_ORIGIN=http://localhost:5174

# The clone holds real guest/staff contacts: never let the city instance send email or payments.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Own uploads dir so the city instance never touches the real one.
UPLOADS_DIR=./uploads-city

# Name shown on the public hotel register at / (city branch)
CITY_NAME=City

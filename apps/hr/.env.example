# HR app — its own database, separate from the hotel app's.
DATABASE_URL=postgres://mmhotel:CHANGE_ME@localhost:5432/mmhotel_hr
# Optional extra secret mixed into password hashes. Changing it invalidates every password.
AUTH_PEPPER=

# One-time bootstrap for `pnpm db:seed` — the first Main HR account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Main HR
SEED_ORG_NAME=

# Encrypts the mailbox password saved under Settings → Sign-in & email (32 bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: if it is lost the saved mailbox password cannot be read and must be entered again.
APP_ENCRYPTION_KEY=
